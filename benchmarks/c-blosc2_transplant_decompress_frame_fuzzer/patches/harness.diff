--- a/tests/fuzz/CMakeLists.txt
+++ b/tests/fuzz/CMakeLists.txt
@@ -22,6 +22,7 @@ endif()
 
 # sources
 file(GLOB SOURCES fuzz_*.c)
+set(BUG_DISPATCH_SOURCE ${PROJECT_SOURCE_DIR}/__bug_dispatch.c)
 
 # targets and tests
 foreach(source ${SOURCES})
@@ -56,7 +57,8 @@ foreach(source ${SOURCES})
