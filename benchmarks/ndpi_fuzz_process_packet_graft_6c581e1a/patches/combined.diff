+/* **************************************** */
+
+static int getSSCertificateFingerprint_slot20(struct ndpi_detection_module_struct *ndpi_struct,
+                                       struct ndpi_flow_struct *flow) {
+  struct ndpi_packet_struct *packet = &ndpi_struct->packet;
+  u_int16_t tls_record_offset = 0;
+
+  if((packet->packet_direction == 0) /* Client -> Server */
+     || (packet->payload_packet_len == 0))
+    return(1); /* More packets please */
+
+  while(packet->payload_packet_len > tls_record_offset+7) {
+    u_int16_t len = ntohs(*(u_int16_t*)&packet->payload[tls_record_offset+7]);
+
+    if(len > 4096)
+      return(0);
+    tls_record_offset += len + 9;
+  }
+
+  flow->extra_packets_func = NULL; /* We're good now */
+  return(1);
+}
+
+/* **************************************** */
+
+int getSSCertificateFingerprint_slot21(struct ndpi_detection_module_struct *ndpi_struct,
+				struct ndpi_flow_struct *flow) {
+  struct ndpi_packet_struct *packet = &ndpi_struct->packet;
+  u_int16_t tls_record_offset = 0, tls_fingerprint_len;
+
+  if((packet->packet_direction == 0) /* Client -> Server */
+     || (packet->payload_packet_len == 0))
+    return(1); /* More packets please */
+
+  if(packet->payload[tls_record_offset] == 0x0b /* Certificate */) {
+    SHA1_CTX ctx;
+    unsigned int avail;
+
+    tls_record_offset += 8;
+    tls_fingerprint_len = ntohs(*(u_int16_t*)&packet->payload[tls_record_offset]);
+    tls_record_offset = tls_record_offset+2;
+
+    avail = packet->payload_packet_len - tls_record_offset;
+
+    if(avail > tls_fingerprint_len)
+      avail = tls_fingerprint_len;
+
+    SHA1Init(&ctx);
+    SHA1Update(&ctx, &packet->payload[tls_record_offset], avail);
+  }
+
+  return(1);
+}
