+static int getSSCertificateFingerprint(struct ndpi_detection_module_struct *ndpi_struct,
+				       struct ndpi_flow_struct *flow) {
+  struct ndpi_packet_struct *packet = &ndpi_struct->packet;
+  u_int16_t tls_record_offset = 8 /* multiple_messages */;
+  u_int16_t tls_fingerprint_len;
+  SHA1_CTX srv_cert_fingerprint_ctx;
+
+  if((packet->packet_direction == 0) /* Client -> Server */
+     || (packet->payload_packet_len == 0)
+     || (packet->payload[0] != 0xb) /* Certificate */)
+    return(1);
+
+  tls_fingerprint_len = ntohs(*(u_int16_t*)&packet->payload[tls_record_offset]);
+  tls_record_offset = tls_record_offset + 2;
+
+  {
+    unsigned int avail = packet->payload_packet_len - tls_record_offset;
+
+    if(avail > tls_fingerprint_len)
+      avail = tls_fingerprint_len;
+
+    SHA1Init(&srv_cert_fingerprint_ctx);
+    SHA1Update(&srv_cert_fingerprint_ctx,
+	       &packet->payload[tls_record_offset],
+	       avail);
+  }
+
+  flow->extra_packets_func = NULL; /* We're good now */
+  return(1);
+}
