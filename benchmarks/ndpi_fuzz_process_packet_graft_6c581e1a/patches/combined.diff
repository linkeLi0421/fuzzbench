+
+#include "ndpi_protocol_ids.h"
+
+#define NDPI_CURRENT_PROTO NDPI_PROTOCOL_YAHOO
+
+#include "ndpi_api.h"
+#include "ndpi_private.h"
+#include "../../../__bug_dispatch.h"
+
+#define FLAPVERSION         0x00000001
+
+/* Flap channels */
+#define SIGNON              0x01
+
+static void ndpi_int_oscar_add_connection(struct ndpi_detection_module_struct *ndpi_struct,
+					  struct ndpi_flow_struct *flow)
+{
+  ndpi_set_detected_protocol(ndpi_struct, flow, NDPI_PROTOCOL_YAHOO, NDPI_PROTOCOL_UNKNOWN,
+			     NDPI_CONFIDENCE_DPI);
+}
+
+static void ndpi_search_oscar_tcp_connect(struct ndpi_detection_module_struct *ndpi_struct,
+					  struct ndpi_flow_struct *flow)
+{
+  struct ndpi_packet_struct *packet = &ndpi_struct->packet;
+
+  /* FLAP__Header
+   *
+   * [ 6 byte FLAP header ]
+   * +-----------+--------------+-------------+--------------+
+   * | 0x2a (1B) | Channel (1B) | SeqNum (2B) | PyldLen (2B) |
+   * +-----------+--------------+-------------+--------------+
+   */
+  if(packet->payload_packet_len >= 6 && packet->payload[0] == 0x2a) {
+    /* FLAP__FRAME_TYPE (Channel) */
+    u_int8_t channel = get_u_int8_t(packet->payload, 1);
+
+    /* SIGNON -> FLAP__SIGNON_FRAME */
+    if(channel == SIGNON &&
+       get_u_int16_t(packet->payload, 4) == htons(packet->payload_packet_len - 6) &&
+       (__BUG_ACTIVE(6)
+	? (get_u_int32_t(packet->payload, 6) == htonl(FLAPVERSION))        /* OSV-2020-992 (NEW) */
+	: (packet->payload_packet_len >= 10 &&
+	   get_u_int32_t(packet->payload, 6) == htonl(FLAPVERSION)))) {    /* Original (OLD) */
+      NDPI_LOG_INFO(ndpi_struct, "found OSCAR - Sign In\n");
+      ndpi_int_oscar_add_connection(ndpi_struct, flow);
+      return;
+    }
+  }
+
+  NDPI_EXCLUDE_DISSECTOR(ndpi_struct, flow);
+}
+
+void ndpi_search_oscar(struct ndpi_detection_module_struct *ndpi_struct, struct ndpi_flow_struct *flow)
+{
+  struct ndpi_packet_struct *packet = &ndpi_struct->packet;
+
+  NDPI_LOG_DBG(ndpi_struct, "search OSCAR\n");
+
+  if(packet->tcp != NULL)
+    ndpi_search_oscar_tcp_connect(ndpi_struct, flow);
+}
+
+void init_oscar_dissector(struct ndpi_detection_module_struct *ndpi_struct)
+{
+  register_dissector("Oscar", ndpi_struct,
+                     ndpi_search_oscar,
+                     NDPI_SELECTION_BITMASK_PROTOCOL_V4_V6_TCP_WITH_PAYLOAD_WITHOUT_RETRANSMISSION,
+                     1, NDPI_PROTOCOL_YAHOO);
+}
